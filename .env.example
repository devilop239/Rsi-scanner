# =============================================================================
# Nifty 50 StochRSI Scanner — Environment Variables
# Copy this file to .env and fill in all values marked REQUIRED.
# Never commit .env to version control.
# =============================================================================

# ── Telegram ──────────────────────────────────────────────────────────────────
# REQUIRED: Get from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Production webhook URL (e.g. https://myapp.onrender.com).
# Leave empty to use long-polling (local development).
WEBHOOK_BASE_URL=

# REQUIRED in production: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=

# URL path for the webhook (default is fine — keep this non-guessable).
WEBHOOK_PATH=/webhook/telegram

# ── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite): sqlite+aiosqlite:///./dev.db
# Production (PostgreSQL): postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ── Access Control ────────────────────────────────────────────────────────────
# REQUIRED: Your Telegram user ID(s), comma-separated.
# Find yours by messaging @userinfobot on Telegram.
ADMIN_IDS=

# REQUIRED: Secret bearer token for POST /internal/run-scan.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=your_cron_secret_here

# ── Indicator Parameters ──────────────────────────────────────────────────────
RSI_LENGTH=14
STOCH_LENGTH=14
STOCH_K_SMOOTH=3
STOCH_D_SMOOTH=3

# Signal line for threshold comparison: 'k' or 'd'
SIGNAL_LINE=k

# Alert thresholds (0–100)
STOCH_LOW=20
STOCH_HIGH=80

# Minimum number of completed candles required before computing indicator
MIN_CANDLES=100

# ── Data / Market Calendar ────────────────────────────────────────────────────
# Number of calendar days of price history to download
DATA_LOOKBACK_DAYS=200

# Max % difference allowed between primary and fallback data sources
PRICE_TOLERANCE_PCT=1.0

# URL for the Nifty 50 constituents CSV from NSE
NIFTY50_CSV_URL=https://www.niftyindices.com/IndexConstituents/ind_nifty50list.csv

# ── Alerting / Deduplication ──────────────────────────────────────────────────
# Days to wait before re-alerting the same stock in the same zone
ALERT_COOLDOWN_DAYS=7

# Set to true to also notify when a stock leaves an extreme zone
ALERT_ON_EXIT=false

# Notify admin if this % of tickers fail during a scan run
MAX_TICKER_FAILURE_PCT=20.0

# ── Scheduling ────────────────────────────────────────────────────────────────
TZ=Asia/Kolkata

# Cron schedule for daily scan (default: Mon-Fri at 16:30 IST)
SCAN_CRON=30 16 * * 1-5

# ── Data Retention ────────────────────────────────────────────────────────────
CANDLE_RETENTION_DAYS=730
INDICATOR_RETENTION_DAYS=365
SCAN_RUN_RETENTION_DAYS=90

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 'development' (long-polling, pretty logs) or 'production' (webhook, JSON logs)
ENVIRONMENT=development

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MESSAGES=5
RATE_LIMIT_WINDOW_SECONDS=60
